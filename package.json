{
  "name": "haramin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-assets.mjs",
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply haramin --local",
    "db:migrate:remote": "wrangler d1 migrations apply haramin --remote",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "prebuild": "node scripts/copy-assets.mjs",
    "build": "wrangler deploy --dry-run --outdir dist"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261002.1",
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "wrangler": "^4.147.0"
  }
}
